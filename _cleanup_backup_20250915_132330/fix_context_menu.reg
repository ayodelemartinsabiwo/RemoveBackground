Windows Registry Editor Version 5.00

; Remove old Background Remover context menu entries
[-HKEY_CLASSES_ROOT\*\shell\RemoveBackground]

; Install new Background Remover context menu
[HKEY_CLASSES_ROOT\*\shell\RemoveBackground]
@="Remove Background"
"Icon"="C:\\RemoveBackground\\dist\\BackgroundRemover.exe"

[HKEY_CLASSES_ROOT\*\shell\RemoveBackground\command]
@="\"C:\\RemoveBackground\\dist\\BackgroundRemover.exe\" \"%1\""
