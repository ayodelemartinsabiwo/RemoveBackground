# Database Configuration
POSTGRES_PASSWORD=your_secure_postgres_password_here
DATABASE_URL=postgresql://palmar_admin:your_secure_postgres_password_here@postgres:5432/palmar_bg_dev

# Redis Configuration
REDIS_PASSWORD=your_secure_redis_password_here
REDIS_URL=redis://:your_secure_redis_password_here@redis:6379

# JWT & Authentication
JWT_SECRET=your_256_bit_secret_key_change_in_production
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here
REFRESH_TOKEN_EXPIRES_IN=30d

# OAuth Providers (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
S3_BUCKET_NAME=palmar-bg-production
S3_BUCKET_REGION=us-east-1

# MinIO (Local Development S3)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_ENDPOINT=http://minio:9000

# Stripe Payment
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# SendGrid Email
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@palmartech.com
SENDGRID_FROM_NAME=Palmar Background Remover

# Application URLs
API_URL=http://localhost:3000
WORKER_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# CORS Configuration
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload Limits
MAX_FILE_SIZE=26214400
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,image/tiff,image/bmp

# Image Processing
PROCESSING_TIMEOUT=30000
MAX_PROCESSING_QUEUE_SIZE=1000

# Monitoring & Logging
LOG_LEVEL=debug
SENTRY_DSN=
DATADOG_API_KEY=

# Feature Flags
ENABLE_API=true
ENABLE_OAUTH=false
ENABLE_WEBHOOKS=true
ENABLE_BATCH_PROCESSING=true

# Security
BCRYPT_ROUNDS=12
CSRF_SECRET=your_csrf_secret_here
HELMET_ENABLED=true

# Session
SESSION_SECRET=your_session_secret_here
SESSION_MAX_AGE=86400000

# Worker Configuration
CELERY_BROKER_URL=redis://:your_secure_redis_password_here@redis:6379/0
CELERY_RESULT_BACKEND=redis://:your_secure_redis_password_here@redis:6379/1
WORKER_CONCURRENCY=4

# AI Model Configuration
MODEL_NAME=birefnet-portrait
MODEL_CACHE_DIR=/app/models
ONNX_PROVIDERS=CPUExecutionProvider
