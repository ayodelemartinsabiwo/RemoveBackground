# ==============================================
# Palmar Professional - Environment Variables
# ==============================================
# Copy this file to .env and update values

# ---------------------------------------------
# Database
# ---------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/palmar_bg

# ---------------------------------------------
# Redis
# ---------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------------------------------------------
# JWT Authentication
# ---------------------------------------------
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---------------------------------------------
# S3 / MinIO Storage
# ---------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=palmar-bg-images
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# ---------------------------------------------
# API Configuration
# ---------------------------------------------
NODE_ENV=development
PORT=3001
API_BASE_URL=http://localhost:3001
LOG_LEVEL=debug

# ---------------------------------------------
# Worker Configuration
# ---------------------------------------------
MODEL_NAME=birefnet-portrait
SMALL_RESOLUTION=512
HD_RESOLUTION=1920
ULTRA_HD_RESOLUTION=3840

# ---------------------------------------------
# Frontend Configuration
# ---------------------------------------------
VITE_API_BASE_URL=http://localhost:3001/api

# ---------------------------------------------
# Rate Limiting
# ---------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ---------------------------------------------
# Email (Optional - for password reset, etc.)
# ---------------------------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=noreply@palmar.com

# ---------------------------------------------
# Payment Gateway (Future)
# ---------------------------------------------
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
