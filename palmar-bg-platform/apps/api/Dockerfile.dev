FROM node:20-alpine

# Install OpenSSL for Prisma
RUN apk add --no-cache openssl

WORKDIR /app

# Install dependencies
COPY package*.json ./
RUN npm install

# Copy source
COPY . .

# Make startup script executable
RUN chmod +x /app/start.sh

# Expose port
EXPOSE 3001

# Development command - run startup script
CMD ["/app/start.sh"]
