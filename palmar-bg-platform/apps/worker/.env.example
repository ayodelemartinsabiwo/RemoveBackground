# Application
DEBUG=true

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Celery (uses Redis by default)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/palmar_bg

# S3/MinIO
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=palmar-bg-images
S3_REGION=us-east-1
S3_USE_SSL=false

# AI Model Settings
MODEL_NAME=birefnet-portrait
MODEL_FALLBACK=u2net
MAX_IMAGE_SIZE=1024

# Processing Settings
SMALL_RESOLUTION=512
HD_RESOLUTION=1920
ULTRA_HD_RESOLUTION=3840

# Worker Settings
WORKER_CONCURRENCY=2
TASK_TIME_LIMIT=300
TASK_SOFT_TIME_LIMIT=240
