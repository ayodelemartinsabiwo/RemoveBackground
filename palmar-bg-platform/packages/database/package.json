{
  "name": "@palmar/database",
  "version": "1.0.0",
  "private": true,
  "description": "Database schema, migrations, and ORM for Palmar Background Remover",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
